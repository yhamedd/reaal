# Port the API + web app listen on (not used on Vercel)
PORT=3000
# Local development: the embedded Postgres database (DATA_DIR/pg) and uploaded files (DATA_DIR/uploads)
DATA_DIR=./data

# --- Supabase (production) -------------------------------------------------------------
# Database: Supabase → Connect → "Transaction pooler" connection string (port 6543).
# When empty, the app uses the embedded local database instead.
DATABASE_URL=
# File storage: Supabase → Project Settings → API. Files go to a private bucket that the app
# creates on first upload. When empty, files are stored in DATA_DIR/uploads.
SUPABASE_URL=
# Server-only secret. Never expose it to the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=reaal-files

# --- Vercel ------------------------------------------------------------------------------
# Any long random string; Vercel Cron sends it to /api/cron/daily (verification reminders, cleanup).
CRON_SECRET=

# First Super Admin, created only when the database has no users.
# If ADMIN_PASSWORD is omitted a default is printed and must be changed on first sign-in.
ADMIN_EMAIL=admin@yourcompany.com
ADMIN_PASSWORD=
ADMIN_NAME=System Admin
# Set to true behind a reverse proxy (so rate limiting sees the real client IP). Automatic on Vercel.
TRUST_PROXY=false
# Cookies are Secure in production by default; set false only when serving over plain HTTP
COOKIE_SECURE=true
# Upload size limit in MB (default 20; 4 on Vercel, which caps requests at 4.5 MB)
# MAX_UPLOAD_MB=20
