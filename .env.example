# Port the API + web app listen on
PORT=3000
# Where the SQLite database and uploaded files live
DATA_DIR=./data
# First Super Admin, created only when the database has no users.
# If ADMIN_PASSWORD is omitted a default is printed and must be changed on first sign-in.
ADMIN_EMAIL=admin@yourcompany.com
ADMIN_PASSWORD=
ADMIN_NAME=System Admin
# Set to true behind a reverse proxy (so rate limiting sees the real client IP)
TRUST_PROXY=false
# Cookies are Secure in production by default; set false only when serving over plain HTTP
COOKIE_SECURE=true
MAX_UPLOAD_MB=20
