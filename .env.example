# ---- Database -------------------------------------------------------------
# Leave empty to use a local SQLite file in DATA_DIR.
# On Vercel these come from the Turso integration:
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ---- File storage ---------------------------------------------------------
# Leave empty to store uploads in DATA_DIR/uploads.
# On Vercel this comes from connecting a Blob store:
BLOB_READ_WRITE_TOKEN=

# ---- First Super Admin (created only when the database has no users) ------
ADMIN_EMAIL=admin@yourcompany.com
ADMIN_PASSWORD=
ADMIN_NAME=System Admin

# ---- Scheduled jobs on Vercel (daily verification reminders & cleanup) ----
CRON_SECRET=

# ---- Local / self-hosted only ---------------------------------------------
PORT=3000
DATA_DIR=./data
# Set to true behind a reverse proxy so rate limiting sees the real client IP
TRUST_PROXY=false
# Cookies are Secure in production by default; set false only on plain HTTP
COOKIE_SECURE=true
MAX_UPLOAD_MB=20
